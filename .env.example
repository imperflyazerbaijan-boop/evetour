# Copy to .env and fill in the real values. Never commit .env itself.

# Absolute, or relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Anyone holding this can mint a valid admin
# session, so keep it secret and rotate it if it is ever exposed.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# The admin password. `npm run db:seed` writes its hash into the database.
# There is deliberately no fallback: the seed refuses to run without one,
# rather than create a predictable account.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=""

# Used for canonical URLs, the sitemap and schema.org. Must be https in
# production — `npm run check:deploy` fails the build otherwise.
NEXT_PUBLIC_SITE_URL="https://evetour.az"

# Both drivers ship with the app. A file: URL selects SQLite, a postgres:// URL
# selects Postgres, and src/lib/db-adapter.ts picks the adapter at runtime — so
# switching databases needs no code change. See docs/DEPLOY.md.
#
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"