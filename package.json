{
  "name": "eve-tour",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed-reviews": "tsx prisma/seed-reviews.ts",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "check:admin": "tsx scripts/check-admin.ts",
    "check:admin-e2e": "tsx scripts/check-admin-e2e.ts",
    "check:tours": "tsx scripts/check-tours.ts",
    "check:i18n": "tsx scripts/check-i18n-content.ts",
    "check:deploy": "tsx scripts/check-deploy.ts",
    "fix:mojibake": "tsx scripts/fix-mojibake.ts",
    "fix:mojibake:source": "tsx scripts/fix-source-mojibake.ts",
    "check:all": "npm run check:tours && npm run check:i18n && npm run check:admin && npm run check:admin-e2e && npm run check:deploy"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "motion": "^13.4.6",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
